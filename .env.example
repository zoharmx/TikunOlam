# Tikun Olam Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# AI API KEYS (Required)
# ============================================================================

# Google Gemini API Key (for Western perspective analysis)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (for synthesis and advanced reasoning)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Key (for Eastern perspective analysis in BinahSigma)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (optional, fallback)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# GOOGLE CLOUD PLATFORM (for Vertex AI)
# ============================================================================

# GCP Project ID (required for Vertex AI)
# Get from: https://console.cloud.google.com/
GCP_PROJECT_ID=your-gcp-project-id

# GCP Region/Location for Vertex AI
# Recommended: us-central1, us-east1, europe-west1
GCP_LOCATION=us-central1

# ============================================================================
# DATADOG OBSERVABILITY (for hackathon)
# ============================================================================

# Datadog API Key
# Get from: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=your_datadog_api_key_here

# Datadog Application Key
# Get from: https://app.datadoghq.com/organization-settings/application-keys
DATADOG_APP_KEY=your_datadog_app_key_here

# Datadog Service Name
DATADOG_SERVICE_NAME=tikun-olam

# ============================================================================
# TIKUN CONFIGURATION
# ============================================================================

# Environment (development, staging, production)
TIKUN_ENV=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Output directory for results
OUTPUT_DIR=./results

# ============================================================================
# MODEL CONFIGURATION (Vertex AI Models)
# ============================================================================

# Default models for each Sefirah
# Note: Using Vertex AI for Gemini models
KETER_MODEL=gemini-1.5-pro
CHOCHMAH_MODEL=gemini-1.5-pro
BINAH_WEST_MODEL=gemini-1.5-pro
BINAH_EAST_MODEL=deepseek-chat
CHESED_MODEL=gemini-1.5-pro
GEVURAH_MODEL=gemini-1.5-pro
TIFERET_MODEL=gemini-1.5-pro
NETZACH_MODEL=gemini-1.5-pro
HOD_MODEL=gemini-1.5-pro
YESOD_MODEL=gemini-1.5-pro
MALCHUT_MODEL=gemini-1.5-pro

# ============================================================================
# PERFORMANCE & LIMITS
# ============================================================================

# API request timeout (seconds)
API_TIMEOUT=120

# Maximum retries for failed API calls
MAX_RETRIES=3

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=60

# Enable caching
ENABLE_CACHE=true

# Cache TTL (seconds)
CACHE_TTL=3600

# ============================================================================
# BINAHSIGMA CONFIGURATION
# ============================================================================

# BinahSigma activation threshold (% geopolitical keywords)
BINAH_SIGMA_THRESHOLD=0.15

# Minimum bias delta for "high divergence" (%)
BINAH_HIGH_DIVERGENCE_THRESHOLD=40

# ============================================================================
# API SERVER (if using FastAPI)
# ============================================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# Enable API docs
API_DOCS_ENABLED=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# MONITORING & TELEMETRY
# ============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Prometheus metrics port
METRICS_PORT=9090

# Enable distributed tracing
ENABLE_TRACING=false

# ============================================================================
# SECURITY
# ============================================================================

# API authentication token (if needed)
API_AUTH_TOKEN=

# Enable request validation
STRICT_VALIDATION=true

# Maximum scenario text length (characters)
MAX_SCENARIO_LENGTH=50000
