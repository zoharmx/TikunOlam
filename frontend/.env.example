# Tikun Olam Frontend - Environment Variables

# ============================================================================
# DATADOG RUM (Real User Monitoring)
# ============================================================================

# Datadog Application ID for RUM
# Get from: https://app.datadoghq.com/organization-settings/client-tokens
VITE_DATADOG_APP_ID=your-app-id

# Datadog Client Token for browser-side RUM
# Get from: https://app.datadoghq.com/organization-settings/client-tokens
VITE_DATADOG_CLIENT_TOKEN=your-client-token

# Datadog Dashboard URL (optional, for embedding)
# Format: https://app.datadoghq.com/dashboard/xyz?from_ts=...&to_ts=...&live=true
VITE_DATADOG_DASHBOARD_URL=

# ============================================================================
# BACKEND API
# ============================================================================

# Backend API URL (local development)
VITE_API_URL=http://localhost:8000

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment (development, staging, production)
VITE_ENV=development
